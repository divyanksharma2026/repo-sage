# Database
DATABASE_URL="postgresql://reposage:reposage@localhost:5432/reposage"

# Redis
REDIS_URL="redis://localhost:6379"

# GitHub OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Session
SESSION_SECRET="change-me-to-a-random-32-char-string"

# LLM — set one, the factory picks it up
LLM_PROVIDER="gemini"   # gemini | openai | groq
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Google retires model ids without notice, and its newest free-tier models
# often return 503 "high demand". Override here instead of editing code.
# List what your key can actually use:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"
# Must be able to emit 768-dim vectors (code_chunks.embedding is vector(768)).
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Embeddings for code search / chat. Groq has no embedding API, so this is
# separate from LLM_PROVIDER and reuses the GEMINI/OPENAI key above.
EMBEDDING_PROVIDER="gemini"   # gemini | openai

# App URLs
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Server-side GitHub token. REQUIRED for anonymous analysis of public repos:
# one analysis makes 100+ GitHub calls and unauthenticated access allows only
# 60/hour, so POST /repos/:id/analyze returns 503 without this. Signed-in users
# analyze with their own token instead. A classic PAT with no scopes ticked, or
# a fine-grained token with public read access, is enough.
# Create one at https://github.com/settings/tokens
GITHUB_PAT=""
