# Database
DATABASE_URL="postgresql://reposage:reposage@localhost:5432/reposage"

# Redis
REDIS_URL="redis://localhost:6379"

# GitHub OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Session
SESSION_SECRET="change-me-to-a-random-32-char-string"

# LLM — set one, the factory picks it up
LLM_PROVIDER="gemini"   # gemini | openai | groq
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""

# App URLs
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Optional: your own GitHub PAT to raise API rate limits during dev
GITHUB_PAT=""
